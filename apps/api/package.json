{
  "name": "@jev/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/dist/**'",
    "seed:dev": "tsx src/seed-dev.ts",
    "accept:gateway": "tsx src/acceptance-gateway.ts"
  },
  "dependencies": {
    "@jev/auth": "0.1.0",
    "@jev/control": "0.1.0",
    "@jev/db": "0.1.0",
    "@jev/model-gateway": "0.1.0",
    "@jev/shared": "0.1.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "vitest": "4.1.12"
  }
}
