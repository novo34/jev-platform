DATABASE_URL=postgresql://jev:jev@localhost:5432/jev
API_HOST=0.0.0.0
API_PORT=3001
WORKER_HOST=0.0.0.0
WORKER_HEALTH_PORT=3002

# Optional GitHub App: configure all six together, through secure injection.
# JEV_GITHUB_APP_ID=12345
# JEV_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/jev-github-app.pem
# JEV_GITHUB_APP_SLUG=your-jev-app
# JEV_GITHUB_CLIENT_ID=your-app-client-id
# JEV_GITHUB_CLIENT_SECRET=configure-in-secret-manager
# JEV_GITHUB_CALLBACK_URL=https://your-jev-domain/api/integrations/github/callback
# Optional JSON: trustedReviewerIds are stable GitHub user IDs; requiredChecks bind names to App IDs.
# Without an explicitly configured policy, merge is denied.
# JEV_GITHUB_MERGE_POLICY={"trustedReviewerIds":[12345],"requiredChecks":[{"name":"validate","appId":67890}]}
